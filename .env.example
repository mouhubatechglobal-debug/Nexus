# ------------------------------------------------------------------
# NEXUS — variables d'environnement
# Copier ce fichier vers .env à la racine puis adapter les valeurs.
# Toutes les valeurs ont des défauts sûrs pour le développement local.
# JAMAIS de vraie information sensible dans ce fichier.
# ------------------------------------------------------------------

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Niveau de log : fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# API (Fastify)
PORT=3001
# Origines CORS autorisées (séparées par des virgules) — jamais `*`
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite) — cible du proxy /api en développement
API_PROXY_TARGET=http://localhost:3001

# ------------------------------------------------------------------
# PostgreSQL (Drizzle)
# DATABASE_URL : chaîne de connexion du serveur PostgreSQL.
# DB_DRIVER : « postgres » (serveur réel) ou « embedded » (PGlite WASM,
# sans serveur : démonstration, CI, sandbox). Aucun identifiant réel ici.
# ------------------------------------------------------------------
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
DB_DRIVER=embedded

# Redis (BullMQ) — requis uniquement si QUEUE_DRIVER=bullmq
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# File de jobs : « memory » (défaut, même contrat sans serveur —
# développement/sandbox, non persistant) ou « bullmq » (Redis requis ;
# Redis injoignable → échec rapide honnête, jamais d'attente infinie).
# ------------------------------------------------------------------
QUEUE_DRIVER=memory

# Sandbox (Prompt 18) : à laisser à 0. Mettre à 1 ne donne JAMAIS accès à
# une exécution réelle — les drivers gVisor/Firecracker/local-process sont
# ARCHITECTURE_ONLY tant que l'isolation n'existe pas.
NEXUS_ALLOW_UNSAFE_LOCAL=0

# ------------------------------------------------------------------
# NEXUS Pay (Prompt 21) : secret HMAC des webhooks providers.
# OBLIGATOIRE de définir une valeur forte aléatoire en production
# (ex. `openssl rand -base64 32`). Les providers réels (Mixx by Yas,
# Moov Money, Wave, MTN Money, cartes) ne sont PAS configurés : les
# adaptateurs sont des abstractions sans appel réseau fabriqué.
# ------------------------------------------------------------------
PAY_WEBHOOK_SECRET=change-me-in-production-with-openssl-rand

# ------------------------------------------------------------------
# Provider IA (OpenAI-compatible) — clé JAMAIS dans le code, env only.
# Sans provider joignable, l'API renvoie des erreurs honnêtes
# (AI_PROVIDER_ERROR / AI_TIMEOUT), jamais de réponse inventée.
# ------------------------------------------------------------------
AI_BASE_URL=http://127.0.0.1:8080
AI_MODEL=local
# AI_API_KEY= (définir ici si le provider en exige une)
AI_TIMEOUT_MS=30000

# ------------------------------------------------------------------
# Authentification
# COOKIE_SECRET : OBLIGATOIRE de définir une valeur forte aléatoire en
# production (ex. `openssl rand -base64 32`). Le défaut est réservé au
# développement local.
# ------------------------------------------------------------------
COOKIE_SECRET=change-me-in-production-with-openssl-rand
SESSION_TTL_HOURS=72
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
